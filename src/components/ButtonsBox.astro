---
import { Icon } from "astro-icon/components";

interface Props {
    title?: string;
    links: Array<{
        href: string;
        icon?: string;
        title: string;
        target?: string;
        rel?: string;
        iconPosition?: 'left' | 'right';
    }>;
}

const { links, title } = Astro.props as Props;
---
<div class="flex flex-col gap-5 my-8">
    {title && <span class="font-semibold text-secondary text-xl md:text-2xl lg:text-3xl leading-tight">{title}</span>}
    <div class="flex flex-col gap-3 md:gap-4 md:flex-wrap md:flex-row justify-start items-center">
        {links.map(({ href, icon, title, target, rel, iconPosition = 'left' }) => (
            <a href={href} target={target} rel={rel} class="flex bg-secondary flex-1 md:flex-none text-primary px-5 py-3 flex-row items-center text-[18px] gap-2 font-normal hover:cursor-pointer hover:bg-primary hover:text-secondary border border-secondary transition-all duration-200 no-underline w-full md:w-max justify-center">
                {icon && iconPosition === 'left' && <Icon name={icon} />}
                {title}
                {icon && iconPosition === 'right' && <Icon name={icon} />}
            </a>
        ))}
    </div>
</div>
