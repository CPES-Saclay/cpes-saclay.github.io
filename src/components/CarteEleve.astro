---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl } from '../i18n';

interface Props {
  nom: string;
  photo?: string;
  annee: string;
  parcours: 'sante' | 'societe';
  showParcours?: boolean;
  promo?: string | null;
  linkedin?: string | null;
  contact?: string | null;
  logos?: { src: string; ratio: number; label: string }[];
  etablissement?: string | null;
  formation?: string | null;
}

const { nom, photo, annee, parcours, showParcours = true, promo, linkedin, contact, logos, etablissement, formation } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const parcoursLabel = parcours === 'sante'
  ? (lang === 'fr' ? 'Santé' : 'Health')
  : (lang === 'fr' ? 'Société' : 'Society');
---

<article class="h-full px-3 py-5 bg-secondary/5" data-annee={annee} data-parcours={parcours}>
  <div class="flex items-center gap-4">
    {photo && <div role="img" aria-label={nom} style={`background-image: url('${photo}')`} class="w-16 h-16 rounded-full shrink-0 bg-cover bg-center etudiant-photo"></div>}
    <div class="flex-1 min-w-0 flex flex-col gap-0">
      <div class="flex items-center justify-between gap-2">
        <span class="font-semibold text-[0.95rem] leading-tight text-secondary m-0">{nom}</span>
        {(linkedin || contact) && (
          <div class="flex gap-1">
            {linkedin && (
              <a href={linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center text-[1.1rem] no-underline text-secondary bg-transparent border-none" aria-label="LinkedIn">
                <Icon name="ri:linkedin-box-fill" />
              </a>
            )}
            {contact && (
              <a href={`mailto:${contact}`} class="inline-flex items-center justify-center text-[1.1rem] no-underline text-secondary bg-transparent border-none" aria-label={`Contacter ${nom}`}>
                <Icon name="ri:mail-fill" />
              </a>
            )}
          </div>
        )}
      </div>
      <div class="flex items-center gap-[0.3rem] pt-2 flex-wrap">
        <span class="text-sm font-semibold h-6 px-1.5 text-center uppercase border border-secondary text-primary bg-secondary">{annee}</span>
        {showParcours && <span class="text-sm font-medium h-6 px-1.5 border border-secondary text-secondary">{parcoursLabel}</span>}
        {promo && <span class="text-sm text-secondary ml-auto">{promo}</span>}
        {logos && logos.length > 0 && (
          <div class="flex items-center gap-1.5 ml-auto">
            {logos.map(l => (
              <span class="debouche-logo" role="img" aria-label={l.label} title={l.label}>
                <span class="debouche-logo-img" style={`aspect-ratio: ${l.ratio}; background-image: url('${l.src}')`}></span>
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
  {(etablissement || formation) && (
    <div class="mt-3 pt-3 border-t border-secondary/10 flex flex-col gap-0.5">
      {etablissement && <span class="text-sm font-semibold text-secondary leading-snug">{etablissement}</span>}
      {formation && <span class="text-[0.8rem] text-secondary leading-snug">{formation}</span>}
    </div>
  )}
</article>


<style>
  .etudiant-photo {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  .debouche-logo {
    display: inline-flex;
    align-items: center;
  }
  .debouche-logo-img {
    display: block;
    height: 1.6rem;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }
  :global(:root[data-theme="cpes-paris-saclay-dark"]) .debouche-logo {
    background-color: #fff;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
  }
</style>