---
import programmeFr from '../data/programme-fr.json';
import programmeEn from '../data/programme-en.json';

export interface Props {
  annee: 'L1' | 'L2' | 'L3';
  lang: string;
  height?: number;
}

const { annee, lang, height = 240 } = Astro.props;
const programme = lang === 'fr' ? programmeFr : programmeEn;
const data = (programme as any)[annee];

/* Palette : une teinte par bloc, déclinée en rampe ordinale pour les matières
   de ce bloc. Teintes de bloc et rampes validées avec scripts/validate_palette.js
   du skill dataviz, dans les deux modes (surfaces #ffffff et #0a0a0a) :
   - 3 teintes de bloc, toutes paires : CVD ΔE 9.2 clair / 9.4 sombre, vision
     normale 24.0 / 20.9 ;
   - 6 rampes ordinales de 8 pas : monotones, ΔL ≈ 0.063 par pas, extrémité
     claire au-dessus du plancher de 2:1 sur la surface.
   L'aqua clair est à 2.82:1 sur blanc : la règle de relief est satisfaite par la
   légende nommée et par le tableau récapitulatif de la même page. */
const BLOCS = ['fondamentaux', 'applicatifs', 'transverse'] as const;

const BLOC_TEINTE: Record<string, { light: string; dark: string }> = {
  fondamentaux: { light: '#2a78d6', dark: '#3987e5' },
  applicatifs:  { light: '#eb6834', dark: '#d95926' },
  transverse:   { light: '#1baf7a', dark: '#199e70' },
};

const BLOC_RAMPE: Record<string, { light: string[]; dark: string[] }> = {
  fondamentaux: {
    light: ['#7ab4ff', '#539fff', '#3e8aea', '#2977d5', '#0f63c0', '#0152a3', '#004185', '#013167'],
    dark:  ['#aed1ff', '#8abdfe', '#65a8ff', '#4693f3', '#327fde', '#1b6cc9', '#0059b2', '#014892'],
  },
  applicatifs: {
    light: ['#ff8d64', '#f4703d', '#de5c26', '#c84805', '#ac3c01', '#8f3102', '#742602', '#5a1b00'],
    dark:  ['#ffbca3', '#ff9c78', '#fe7946', '#e86531', '#d25117', '#b84102', '#9b3602', '#802a00'],
  },
  transverse: {
    light: ['#48cc95', '#2cb882', '#00a470', '#018e61', '#027952', '#026443', '#025035', '#023d28'],
    dark:  ['#6aeab2', '#52d59e', '#39c18b', '#15ad78', '#019767', '#028258', '#026d4a', '#02593b'],
  },
};

const SPEC_LABEL = lang === 'fr' ? 'Parcours Santé ou Société' : 'Health or Society Track';

/* Les électifs « au choix » (parcours, options HEC, modules optionnels) ne comptent
   qu'une seule fois par groupe : l'étudiant n'en suit qu'un. Les deux branches du
   parcours sont en plus fondues sous un libellé commun, étant exclusives. */
interface Part { nom: string; ects: number; bloc: string; rang: number }
const parts: Part[] = [];

for (const blocKey of BLOCS) {
  const bloc = (data.blocs as any)[blocKey];
  if (!bloc) continue;
  const seenGroupes = new Set<string>();
  const duBloc: Part[] = [];
  for (const m of bloc.matieres) {
    if (m.electif && m.groupe) {
      if (seenGroupes.has(m.groupe)) continue;
      seenGroupes.add(m.groupe);
    }
    duBloc.push({
      nom: m.groupe === 'parcours' ? SPEC_LABEL : m.intitule,
      ects: m.ects,
      bloc: blocKey,
      rang: 0,
    });
  }
  duBloc.sort((a, b) => b.ects - a.ects);
  duBloc.forEach((p, i) => { p.rang = i; });
  parts.push(...duBloc);
}

/* Les matières restent groupées par bloc et triées par ECTS : l'anneau des
   matières se lit alors comme trois arcs, un par bloc, et recoupe visuellement
   l'anneau des blocs. */
const teinte = (p: Part, mode: 'light' | 'dark') => {
  const rampe = BLOC_RAMPE[p.bloc][mode];
  return rampe[Math.min(p.rang, rampe.length - 1)];
};

const serieMatieres = (mode: 'light' | 'dark') =>
  parts.map(p => ({ name: p.nom, value: p.ects, itemStyle: { color: teinte(p, mode) } }));

const blocsPresents = BLOCS.filter(b => (data.blocs as any)[b]);
const serieBlocs = (mode: 'light' | 'dark') =>
  blocsPresents.map(b => ({
    name: (data.blocs as any)[b].nom,
    value: (data.blocs as any)[b].ects,
    itemStyle: { color: BLOC_TEINTE[b][mode] },
  }));

const legendeMatieres = parts.map(p => ({
  name: p.nom,
  ects: p.ects,
  light: teinte(p, 'light'),
  dark: teinte(p, 'dark'),
}));

const legendeBlocs = blocsPresents.map(b => ({
  name: (data.blocs as any)[b].nom,
  ects: (data.blocs as any)[b].ects,
  light: BLOC_TEINTE[b].light,
  dark: BLOC_TEINTE[b].dark,
}));

const tUnite = lang === 'fr' ? 'ECTS' : 'ECTS';
const tParBloc = lang === 'fr' ? 'Par bloc' : 'By block';
const tParMatiere = lang === 'fr' ? 'Par matière' : 'By subject';
---

<div class="charts-wrap">
  <section class="chart-card chart-blocs">
    <p class="chart-caption">{tParBloc}</p>
    <div class="chart-layout">
      <div
        id={`echarts-blocs-${annee}`}
        class="pie-area"
        style={`width:${height}px;height:${height}px`}
        data-series-light={JSON.stringify(serieBlocs('light'))}
        data-series-dark={JSON.stringify(serieBlocs('dark'))}
      ></div>

      <ul class="legend-list legend-inline">
        {legendeBlocs.map(item => (
          <li class="legend-item">
            <span class="legend-circle" style={`--c-light:${item.light};--c-dark:${item.dark}`}></span>
            <span class="legend-name">{item.name}<span class="legend-ects">{item.ects} {tUnite}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="chart-card chart-matieres">
    <p class="chart-caption">{tParMatiere}</p>
    <div class="chart-layout">
      <div
        id={`echarts-${annee}`}
        class="pie-area"
        style={`width:${height}px;height:${height}px`}
        data-series-light={JSON.stringify(serieMatieres('light'))}
        data-series-dark={JSON.stringify(serieMatieres('dark'))}
      ></div>

      <ul class="legend-list legend-colonnes" style={`max-height:${height}px`}>
        {legendeMatieres.map(item => (
          <li class="legend-item" title={`${item.name} · ${item.ects} ${tUnite}`}>
            <span class="legend-circle" style={`--c-light:${item.light};--c-dark:${item.dark}`}></span>
            <span class="legend-name">{item.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</div>

<script>
  import * as echarts from 'echarts';

  const instances = new Map<string, { chart: echarts.ECharts; ro: ResizeObserver }>();

  function buildOption(isDark: boolean) {
    const gapColor = isDark ? '#0a0a0a' : '#ffffff';
    const textColor = isDark ? '#ffffff' : '#000000';

    return {
      tooltip: {
        trigger: 'item' as const,
        confine: true,
        backgroundColor: isDark ? 'rgba(10,10,10,0.96)' : 'rgba(255,255,255,0.97)',
        borderColor: isDark ? '#ffffff' : '#000000',
        borderWidth: 1,
        borderRadius: 0,
        padding: [7, 13],
        textStyle: {
          fontFamily: 'Montserrat, sans-serif',
          fontSize: 12,
          color: textColor,
        },
        formatter: (p: any) =>
          `<span style="font-size:11px;opacity:.65">${p.name}</span><br/>` +
          `<strong style="font-size:13px">${p.value} ECTS</strong>` +
          `<span style="opacity:.4;margin-left:6px">${p.percent}%</span>`,
      },
      series: [
        {
          type: 'pie' as const,
          center: ['50%', '50%'],
          radius: ['54%', '92%'],
          label: { show: false },
          labelLine: { show: false },
          itemStyle: {
            borderWidth: 2.5,
            borderColor: gapColor,
          },
          emphasis: {
            scale: true,
            scaleSize: 5,
            itemStyle: { opacity: 0.8 },
          },
          data: [] as any[],
        },
      ],
    };
  }

  function initChart(el: HTMLElement) {
    const id = el.id;
    const old = instances.get(id);
    if (old) {
      old.ro.disconnect();
      old.chart.dispose();
      instances.delete(id);
    }

    const isDark = document.documentElement.getAttribute('data-theme')?.includes('dark') ?? false;
    const series = JSON.parse((isDark ? el.dataset.seriesDark : el.dataset.seriesLight) || '[]');

    const chart = echarts.init(el);
    const option = buildOption(isDark);
    option.series[0].data = series;
    chart.setOption(option);

    const ro = new ResizeObserver(() => chart.resize());
    ro.observe(el);
    instances.set(id, { chart, ro });
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>('.pie-area[data-series-light]').forEach(initChart);
  }

  initAll();

  new MutationObserver(initAll).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>

<style>
  /* Sur grand écran les deux graphiques partagent une ligne et s'alignent sur
     la même hauteur ; en dessous ils repassent l'un sous l'autre. */
  .charts-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 2rem 2.5rem;
  }

  /* Les deux anneaux ont la même taille et, par align-items: stretch, les deux
     cartes la même hauteur. La carte des matières prend en revanche la largeur
     restante : sa légende a besoin de deux colonnes pour ne pas s'allonger. */
  .chart-blocs {
    flex: 0 1 auto;
  }

  .chart-matieres {
    flex: 1 1 auto;
    min-width: 0;
  }

  .legend-inline {
    max-width: 11rem;
  }

  .chart-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .chart-layout {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex: 1;
    min-width: 0;
  }

  .chart-caption {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-secondary);
  }

  /* Les noms de bloc sont longs : on borne la colonne pour que l'anneau des
     matières garde la place de déployer sa légende sur deux colonnes. */
  .legend-inline .legend-name {
    white-space: normal;
  }

  .legend-ects {
    display: block;
    font-size: 0.62rem;
    color: color-mix(in srgb, var(--color-secondary) 55%, transparent);
  }

  .pie-area {
    flex-shrink: 0;
  }

  .legend-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    align-content: flex-start;
    gap: 6px;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  /* La légende s'empile en colonnes : sans largeur bornée, une colonne prend la
     largeur de son plus long libellé et la suivante déborde du cadre. La borne
     déclenche l'ellipsis, le nom complet restant dans l'attribut title. */
  .legend-colonnes {
    flex-wrap: wrap;
  }

  .legend-colonnes .legend-item {
    max-width: 13rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    max-width: 100%;
    cursor: default;
    margin: 0;
    padding: 0 1rem 0 0;
  }

  .legend-item::before {
    content: none;
  }

  /* La pastille porte les deux valeurs : la variante sombre n'est pas un
     basculement automatique, c'est un pas choisi pour la surface sombre. */
  .legend-circle {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--c-light);
  }

  :global(:root[data-theme="cpes-paris-saclay-dark"]) .legend-circle {
    background: var(--c-dark);
  }

  .legend-name {
    font-size: 0.68rem;
    line-height: 1.25;
    padding: 1px 0;
    color: var(--color-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Empilés, les graphiques disposent de toute la largeur : la légende repasse
     en colonne unique et les bornes qui servaient à faire tenir deux colonnes
     côte à côte n'ont plus lieu d'être. */
  @media (max-width: 1200px) {
    .charts-wrap {
      flex-direction: column;
    }

    .legend-colonnes {
      max-height: none !important;
      flex-wrap: nowrap;
    }

    .legend-inline,
    .legend-colonnes .legend-item,
    .legend-item {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .chart-layout {
      flex-direction: column;
      align-items: flex-start;
    }

    .legend-list {
      gap: 0.35rem;
      width: 100%;
    }

    /* Sur mobile, la légende passe pleine largeur : le texte doit revenir
       à la ligne au lieu d'être tronqué, et la gouttière de colonne disparaît. */
    .legend-item {
      align-items: flex-start;
      max-width: none;
      padding-right: 0;
    }

    .legend-circle {
      margin-top: 0.28rem;
    }

    .legend-name {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }
  }
</style>
