---
import { Icon } from "astro-icon/components";
import { annonce, annonceActive } from "../data/annonce";

interface Props {
  lang?: "fr" | "en";
}

const { lang = "fr" } = Astro.props;
const t = annonce[lang];
---

{annonceActive() && (
<div
  id="annonce-banner"
  class="bg-[#0026ff] text-white"
  style="display:none"
  data-id={annonce.id}
  data-fin={annonce.fin}
>
  <div class="container mx-auto px-6 py-2.5 md:py-3 flex items-center gap-3">
    <Icon name="ri:calendar-event-line" class="text-base shrink-0" />
    <p class="flex-1 min-w-0 m-0 text-[0.8rem] md:text-[0.85rem] font-medium leading-snug">
      {/* Mobile : version courte, cliquable, pour ne pas occuper la moitié de l'écran. */}
      <a
        href={annonce.lien}
        target="_blank"
        rel="noopener noreferrer"
        class="md:hidden text-white no-underline"
      >
        <strong class="block font-bold">{t.court}</strong>
        <span class="block">{t.date}</span>
      </a>
      <span class="hidden md:inline">{t.texte}</span>
    </p>
    <a
      href={annonce.lien}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:inline-flex shrink-0 items-center gap-1 border border-white px-2.5 py-1 text-[0.75rem] font-semibold no-underline text-white whitespace-nowrap hover:bg-white hover:text-[#0026ff] transition-colors"
    >
      {t.cta}
      <Icon name="ri:arrow-right-up-line" />
    </a>
    <button
      id="annonce-banner-close"
      type="button"
      aria-label={t.fermer}
      class="shrink-0 inline-flex items-center justify-center p-1 -mr-1 text-white hover:opacity-60 transition-opacity cursor-pointer"
    >
      <Icon name="ri:close-line" class="text-lg" />
    </button>
  </div>
</div>
)}

<script is:inline>
  (function () {
    var el = document.getElementById("annonce-banner");
    if (!el) return;
    var KEY = "annonce_" + el.dataset.id + "_fermee";
    var fin = new Date(el.dataset.fin).getTime();

    var GAP = 32;
    function syncPad() {
      var stack = document.getElementById("top-stack");
      var main = document.querySelector("main");
      if (stack && main) main.style.paddingTop = stack.offsetHeight + GAP + "px";
    }

    function estFermee() {
      return document.cookie.split("; ").indexOf(KEY + "=1") !== -1;
    }
    function fermer() {
      el.style.display = "none";
      try {
        // Reste fermée jusqu'à la fin de l'événement.
        var duree = Math.max(60, Math.round((fin - Date.now()) / 1000));
        document.cookie = KEY + "=1; max-age=" + duree + "; path=/; SameSite=Lax";
      } catch (e) {}
      syncPad();
    }

    // Revérifiée dans le navigateur : le site peut avoir été construit avant l'événement.
    if (Date.now() < fin && !estFermee()) {
      el.style.display = "";
      syncPad();
    }

    var btn = document.getElementById("annonce-banner-close");
    if (btn) btn.addEventListener("click", fermer);

    document.addEventListener("DOMContentLoaded", syncPad);
    window.addEventListener("load", syncPad);
    window.addEventListener("resize", syncPad);
    syncPad();
  })();
</script>
