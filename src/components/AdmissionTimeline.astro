---
import { getLangFromUrl } from '../i18n/index';
const lang = getLangFromUrl(Astro.url);

// Session Parcoursup 2027 (rentrée de septembre 2027), source : https://www.parcoursup.gouv.fr/calendrier
const steps = lang === 'en'
  ? [
      { label: "Programmes online",      periode: "17 Dec 2026" },
      { label: "Applications open",      periode: "18 Jan 2027" },
      { label: "Applications close",     periode: "11 Mar 2027" },
      { label: "Confirmation deadline",  periode: "1 Apr 2027" },
      { label: "First admission offers", periode: "1 Jun 2027" },
      { label: "End of the main phase",  periode: "10 Jul 2027" },
    ]
  : [
      { label: "Formations visibles sur Parcoursup", periode: "17 déc. 2026" },
      { label: "Ouverture des vœux",                 periode: "18 janv. 2027" },
      { label: "Clôture des vœux",                   periode: "11 mars 2027" },
      { label: "Confirmation des vœux",              periode: "1er avril 2027" },
      { label: "Premières propositions",             periode: "1er juin 2027" },
      { label: "Fin de la phase principale",         periode: "10 juil. 2027" },
    ];
---

<div class="not-prose my-8">
  <div class="hidden lg:block">
    <div class="flex items-center">
      {steps.map((step, i) => (
        <>
          <div class="w-6 h-6 border-2 border-secondary bg-secondary flex items-center justify-center shrink-0">
            <span class="text-primary text-[10px] font-bold">{i + 1}</span>
          </div>
          {i < steps.length - 1 && (
            <div class="flex-1 h-px bg-secondary/25" />
          )}
        </>
      ))}
    </div>
    <div class="flex items-start mt-3">
      {steps.map((step, i) => {
        const isFirst = i === 0;
        const isLast  = i === steps.length - 1;
        const anchor  = isFirst ? 'left-0' : isLast ? 'right-0' : 'left-1/2 -translate-x-1/2';
        const align   = isFirst ? 'text-left' : isLast ? 'text-right' : 'text-center';
        return (
          <>
            <div class="relative w-6 shrink-0 h-14">
              <div class={`absolute w-32 ${anchor}`}>
                <p class={`text-xs font-semibold uppercase tracking-wider text-secondary ${align}`}>{step.periode}</p>
                <p class={`text-xs text-secondary/55 mt-0.5 ${align}`}>{step.label}</p>
              </div>
            </div>
            {!isLast && <div class="flex-1" />}
          </>
        );
      })}
    </div>
  </div>

  <div class="flex flex-col lg:hidden">
    {steps.map((step, i) => (
      <div class="flex gap-4">
        <div class="flex flex-col items-center">
          <div class="w-6 h-6 border-2 border-secondary bg-secondary flex items-center justify-center shrink-0">
            <span class="text-primary text-[10px] font-bold">{i + 1}</span>
          </div>
          {i < steps.length - 1 && (
            <div class="w-px flex-1 bg-secondary/25 my-1" />
          )}
        </div>
        <div class="pb-5">
          <p class="text-xs font-semibold uppercase tracking-wider text-secondary">{step.periode}</p>
          <p class="text-xs text-secondary/55 mt-0.5">{step.label}</p>
        </div>
      </div>
    ))}
  </div>

</div>
