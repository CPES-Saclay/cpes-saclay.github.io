---
import { Icon } from 'astro-icon/components';
import VideoPlayer from './VideoPlayer.astro';
import presse from '../data/presse.json';
import { getLangFromUrl } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const tr = (b: { fr: string; en: string }) => b[lang] ?? b.fr;
const txt = (fr: string, en?: string) => (lang === 'en' && en ? en : fr);

const V = '/assets/videos/academiedeversailles_';
const temoignages = [
  { src: `${V}rectrice_cpes-paris-saclay`, nom: 'Charline Avenel',
    role: { fr: "Rectrice de l'Académie de Versailles (maintenant Directrice Générale Adjointe de la Région Île-de-France)", en: 'Rector of the Académie de Versailles (now Deputy Director General of the Île-de-France Region)' } },
  { src: `${V}ip-paris_cpes-paris-saclay`, nom: 'Dominique Rossin',
    role: { fr: "Directeur de l'enseignement et de la recherche de l'École Polytechnique (membre fondateur de l'Institut Polytechnique de Paris)",
            en: 'Director of Education and Research at École Polytechnique (founding member of Institut Polytechnique de Paris)' } },
  { src: `${V}hec-paris_cpes-paris-saclay`, nom: 'Kristine de Valck',
    role: { fr: 'Doyenne des Programmes Diplômants à HEC Paris', en: 'Dean of Degree Programmes at HEC Paris' } },
  { src: `${V}universite-paris-saclay_cpes-paris-saclay`, nom: 'Isabelle Demachy',
    role: { fr: "Vice-présidente Affaires académiques de l'Université Paris-Saclay", en: 'Vice-President for Academic Affairs at Université Paris-Saclay' } },
];

const categories = [
  { id: 'presse', label: { fr: 'Articles de presse', en: 'Press articles' } },
  { id: 'partenaires', label: { fr: 'Institutions partenaires', en: 'Partner institutions' } },
  { id: 'video', label: { fr: 'Vidéos', en: 'Videos' } },
];
---

<div class="not-prose flex flex-col gap-12 mt-10">
  {categories.map((cat) => {
    const items = presse.filter((p) => p.categorie === cat.id);
    if (!items.length) return null;
    return (
      <div>
        <h2 class="text-xl font-bold text-secondary mb-5 mt-0">{tr(cat.label)}</h2>
        {cat.id === 'video' && (
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            {temoignages.map((v) => (
              <VideoPlayer src={v.src} title={v.nom} subtitle={tr(v.role)} />
            ))}
          </div>
        )}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {items.map((p) => (
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class="presse-card group flex h-full flex-col gap-3 p-6 border border-secondary/15 no-underline relative"
            >
              {p.logo && (
                <img src={p.logo} alt={p.source} loading="lazy" draggable="false" class="presse-logo h-7 w-auto max-w-[150px] object-contain object-left self-start" />
              )}
              <span class="font-bold text-secondary leading-snug pr-6">{txt(p.titre, p.titre_en)}</span>
              <span class="text-sm text-secondary leading-normal">{txt(p.description, p.description_en)}</span>
              <Icon
                name={p.categorie === 'video' ? 'ri:play-circle-line' : 'ri:external-link-line'}
                class="absolute top-6 right-5 text-base text-secondary opacity-40 group-hover:opacity-100"
              />
            </a>
          ))}
        </div>
      </div>
    );
  })}
</div>

<style>
  .presse-card:hover {
    background-color: color-mix(in srgb, var(--color-secondary) 5%, transparent);
  }

  :global(:root[data-theme="cpes-paris-saclay-dark"]) .presse-logo {
    background-color: #fff;
    border-radius: 4px;
    padding: 3px 6px;
  }
</style>
