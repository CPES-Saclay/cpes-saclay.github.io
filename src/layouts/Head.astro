---
import Posthog from '../components/Posthog.astro';

interface Props {
  title?: string;
  fullTitle?: string;
  description?: string;
  noindex?: boolean;
}

const { title, fullTitle, description, noindex = false } = Astro.props;

const siteName = "CPES Paris-Saclay";
const pageTitle = fullTitle ? fullTitle : (title ? `${title} – ${siteName}` : siteName);
const pageDescription = description || "Le Cycle Pluridisciplinaire d'Études Supérieures de Paris-Saclay : une formation d'excellence pluridisciplinaire.";

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const ogSlug = pathSegments.length === 0 ? 'index' : pathSegments.join('/');
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogLocale = Astro.url.pathname.startsWith('/en') ? 'en_US' : 'fr_FR';
---

<head>
    <meta charset="utf-8" />
    <script is:inline>(function(){try{var a=location.hostname,d="rf.yalcas-sirap-sepc".split("").reverse().join(""),k=a===d||a==="localhost"||a==="127.0.0.1"||a==="::1"||a.slice(-(d.length+1))==="."+d;if(k)return;var H=document.documentElement;H.style.setProperty("display","none","important");try{window.stop&&window.stop()}catch(e){}var P=atob(""),f=function(){try{document.documentElement.innerHTML='<head><meta charset="utf-8"><title>CPES Paris-Saclay</title></head><body style="margin:0">'+P+'</body>';document.documentElement.style.setProperty("display","block","important")}catch(e){}};if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",f);f();setInterval(function(){try{document.getElementById("_cpesp")||f()}catch(e){}},500)}catch(e){}})();</script>
    <link rel="icon" type="image/svg+xml" href="/favicon_d.svg" />
    <link rel="icon" type="image/svg+xml" href="/favicon_d.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon_l.svg" media="(prefers-color-scheme: dark)" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100..900&display=swap" rel="stylesheet">
    <script is:inline data-astro-rerun>var t=localStorage.getItem("theme");document.documentElement.setAttribute("data-theme",t||"cpes-paris-saclay-light");</script>
    <Posthog />
</head>
